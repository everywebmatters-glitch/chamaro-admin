# Fastify backend API base URL, including the /api/v1 version prefix.
# Baked into the static build, so rebuild per environment.
# Production builds read .env.production; for local development put this in .env.development.local:
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=https://api-dev.chamaro.com/api/v1
