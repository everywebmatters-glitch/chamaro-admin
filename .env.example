# Fastify backend API base URL, including the /api/v1 version prefix.
# Baked into the static build, so rebuild per environment.
# Production builds read .env.production; for local development put this in .env.development.local:
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Public value only: NEXT_PUBLIC_ variables are shipped to every browser. Never put a secret, token or database
# URL under a NEXT_PUBLIC_ name. In Cloud Run the value is the NEXT_PUBLIC_API_URL build argument of cloudbuild.yaml
# (_API_URL). api.chamaro.com stays the API host after the move to project-d95e700a-8cd9-4c1a-bd5; to test a
# deployment first, build with the API's run.app URL and add that origin to the backend CORS_ORIGIN.
NEXT_PUBLIC_API_URL=https://api.chamaro.com/api/v1
